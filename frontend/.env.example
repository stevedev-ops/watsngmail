# Local development (these are the defaults — only needed if you change ports)
VITE_API_BASE=http://localhost:8000/api
VITE_WS_BASE=ws://localhost:8000/ws/chat/
VITE_API_KEY=default-key-change-this

# Production (uncomment and fill in when deploying)
# VITE_API_BASE=https://your-backend-domain.com/api
# VITE_WS_BASE=wss://your-backend-domain.com/ws/chat/
# VITE_API_KEY=your_secret_api_key_here
